# ============================================================
# Environment Variables — Copy to .env and fill in your values
# ============================================================

# Football-Data.org — https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=your_football_data_token_here

# The Odds API (v4) — https://the-odds-api.com/
ODDS_API_KEY=your_odds_api_key_here

# Supabase — https://supabase.com/dashboard/project/<your-project>/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
