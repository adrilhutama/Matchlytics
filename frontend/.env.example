# ============================================================
# Frontend Environment Variables: copy to frontend/.env
# ============================================================

# Supabase settings live at: https://supabase.com/dashboard/project/<your-project>/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ------------------------------------------------------------
# Subscription paywall checkout hooks (optional).
# Set these to activate "Proceed to Checkout" in SubscriptionModal.
# Point each at your Midtrans/Sanberpay or Stripe payment link.
# Leave unset and the button stays disabled with an honest note.
# ------------------------------------------------------------
VITE_CHECKOUT_URL_PRO=
VITE_CHECKOUT_URL_SEASON=
VITE_PRICE_PRO_MONTHLY=
VITE_PRICE_SEASON_ANNUAL=
