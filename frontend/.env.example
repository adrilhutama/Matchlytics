# ============================================================
# Frontend Environment Variables: copy to frontend/.env
# ============================================================

# Supabase settings live at: https://supabase.com/dashboard/project/<your-project>/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ------------------------------------------------------------
# Subscription paywall settings (all optional).
#
# Gateway links: point each at a Midtrans/Sanberpay or Stripe
# payment link. When set, "Proceed to Checkout" redirects there
# with the signed-in email attached as customer_email.
# Leave unset and the modal falls back to the manual payment card
# (QRIS / bank transfer instructions + confirmation line below).
VITE_CHECKOUT_URL_PRO=
VITE_CHECKOUT_URL_SEASON=
#
# Displayed prices. Production defaults are built into the app
# (Rp 149.000 / bln and Rp 999.000 / thn); override here only for
# promos or currency changes.
VITE_PRICE_PRO=
VITE_PRICE_ANNUAL=
# Legacy alias, still honored if VITE_PRICE_ANNUAL is unset:
VITE_PRICE_SEASON=
#
# Manual activation confirmation (used when no gateway link is set):
# international phone number, digits only, e.g. 6281234567890
VITE_ADMIN_WHATSAPP=

# ------------------------------------------------------------
# Admin access control
# Comma-separated list of email addresses authorized to access
# the Admin Dashboard (Sidebar > Admin Dashboard link).
# Leave empty to disable admin access.
VITE_ADMIN_EMAILS=

# Optional: GitHub repository for deep-linking to Actions
VITE_GITHUB_REPO=adrilhutama/Matchlytics
