# ============================================================
# .gitignore — Matchlytics
# ============================================================

# Environment variables — NEVER commit secrets
.env
.env.local
.env.*.local

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
env/
venv/
ENV/
.venv/
*.egg-info/
dist/
build/
*.egg

# Node & frontend build artifacts
node_modules/
frontend/dist/
frontend/build/
.vercel

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Test coverage
htmlcov/
.coverage
coverage.xml
